# Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Daily.co: Dashboard -> Developers -> API key
DAILY_API_KEY=

# Any long random string; open /admin?key=THIS
ADMIN_KEY=

# Battle Hour window
BATTLE_HOUR_START=20:00
BATTLE_HOUR_MINUTES=30
BATTLE_HOUR_TZ=America/New_York
# true = always open (local testing only)
BATTLE_HOUR_ALWAYS_OPEN=false
